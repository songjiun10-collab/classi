# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 데이터·모델 산출물(저장소엔 디렉터리 구조만 유지)
data/raw/*
data/processed/*
data/exports/*
!data/**/.gitkeep
models/*
!models/.gitkeep

# Olma 런타임 데이터(개인 메시지·로그인 세션 포함 가능 — 디렉터리 구조만 유지)
olma/storage/*
!olma/storage/.gitkeep

# 로컬 비밀·세션
*.session
.env

# Agent/IDE files
.claude/
.opencode/
opencode.jsonc
.github-disabled/


